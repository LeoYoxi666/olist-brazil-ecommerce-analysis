// 使用中文查询名和中文字段名创建度量值，保证字段窗格与画布全部中文。
已完成订单 =
SUM('月度经营指标'[已完成订单])

商品 GMV =
SUM('月度经营指标'[商品GMV])

平均订单价值 =
DIVIDE([商品 GMV], [已完成订单])

活跃买家 =
SUM('用户RFM分群'[买家数])

复购买家 =
SUM('用户RFM分群'[复购买家])

复购买家率 =
DIVIDE([复购买家], [活跃买家])

延迟订单 =
CALCULATE(
    SUM('配送评价关联'[订单数]),
    '配送评价关联'[是否延迟] = "延迟"
)

延迟交付率 =
DIVIDE(
    [延迟订单],
    SUM('配送评价关联'[订单数])
)

平均评价得分 =
DIVIDE(
    SUMX(
        '配送评价关联',
        '配送评价关联'[订单数] * '配送评价关联'[平均评价得分]
    ),
    SUM('配送评价关联'[订单数])
)

加权同期群留存率 =
DIVIDE(
    SUM('月度同期群留存'[活跃买家]),
    SUM('月度同期群留存'[同期群人数])
)

合格目标客户 =
CALCULATE(
    SUM('同期群RFM目标'[目标客户数]),
    '同期群RFM目标'[是否符合目标条件] = "是"
)

合格目标客户 GMV =
CALCULATE(
    SUM('同期群RFM目标'[目标客户商品GMV]),
    '同期群RFM目标'[是否符合目标条件] = "是"
)

合格风险卖家 =
CALCULATE(
    DISTINCTCOUNT('卖家经营指标'[卖家ID]),
    '卖家经营指标'[是否符合风险排名条件] = "是"
)

行动线路数 =
COUNTROWS('卖家州配送行动')
